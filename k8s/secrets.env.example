# Template for k8s/secrets.env (not committed). PLACEHOLDERS ONLY: never put real keys here.
# `make k8s-secrets` copies this file and appends GROQ_API_KEY / GEMINI_API_KEY from the local .env.
POSTGRES_PASSWORD=change-me
# Must use the same password as POSTGRES_PASSWORD; "postgres" is the Service in postgres.yaml.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/reformulation
