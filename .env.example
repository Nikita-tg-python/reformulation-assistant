# Copy to .env and fill in the secrets: cp .env.example .env
# .env is git-ignored; never commit real keys.

# Postgres connection string (asyncpg DSN).
# docker compose overrides this for the api container to point at the "db" service;
# the value below is for running the app or tests on the host against the compose database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reformulation

# Which LLM provider LLMClient uses: gemini | groq. Switching is this one variable.
# Groq is the default here: on free tiers it answers in seconds, Gemini often returns 503.
LLM_PROVIDER=groq

# Google AI Studio key (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model id. Not every listed model is open to new keys (gemini-3.8-flash was not);
# check what your key can use: https://ai.google.dev/gemini-api/docs/models
# Free tier: 5 requests/min for gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Groq key, fallback provider when Gemini limits run out: https://console.groq.com/keys
GROQ_API_KEY=
# Groq model id with tool use support. Llama models may not be available to new keys;
# list yours: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# Free tier: 8000 tokens/min.
GROQ_MODEL=openai/gpt-oss-120b
# How much the model reasons before answering: none | default | low | medium | high.
# Unset = automatic: "low" for openai/gpt-oss-* (fewer tokens per minute, fewer 400
# output_parse_failed), not sent for other models. Qwen models accept only none | default.
# GROQ_REASONING_EFFORT=low

# sentence-transformers model for embeddings; must produce 384-dim vectors (chunks.embedding is VECTOR(384)).
# multilingual-e5-small instead of the spec's all-MiniLM-L6-v2: the corpus is Ukrainian, MiniLM is English-only
# (hit@3 4/8 vs 8/8 on corpus questions) and truncates at 256 tokens, below the 400-token chunk size.
# Changing the model requires `docker compose up --build` (the image bakes in only this model) and
# re-ingesting the corpus: vectors from different models are not comparable.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Knowledge-base search for /ask and search_knowledge_base:
#   hybrid - vector top 20 + full-text top 20 (Postgres tsvector), fused with Reciprocal Rank
#            Fusion (k=60). Default: finds document codes like SPEC-001, which embeddings miss
#   vector - embeddings only
SEARCH_MODE=hybrid

# How /reformulate runs the agent:
#   pipeline - code calls the tools in a fixed order, the LLM is called 2 times (3 with a retry).
#              Default: it fits free-tier limits (live Groq: 3 of 3 goals, 4-7 s each)
#   loop     - the LLM calls tools itself, up to AGENT_MAX_ITERATIONS calls; needs a model and
#              quota that allow 6+ calls per request (on free tiers it runs out of iterations)
AGENT_MODE=pipeline

# Agent hard limits: max tool-calling iterations and wall-clock timeout (seconds) per /reformulate call
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=60
